<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 1. Tema Base da Aplicação -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">#485460</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- CHAVE DA SOLUÇÃO: Autoriza o Android a pintar as barras do sistema -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <!-- Cores das barras superior e inferior -->
        <item name="android:statusBarColor">#ff0000</item>
        <item name="android:navigationBarColor">#ff0000</item>
    </style>

    <!-- 2. Tema Principal sem Barra de Título (Usado pelo Capacitor) -->
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Reforça a permissão de pintura e cores -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#485460</item>
        <item name="android:navigationBarColor">#485460</item>
    </style>

    <!-- 3. Tema da Tela de Abertura (Splash Screen) -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#485460</item>
        <item name="android:navigationBarColor">#485460</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

</resources>