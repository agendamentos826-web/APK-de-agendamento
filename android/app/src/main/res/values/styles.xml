<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 1. Tema Base da Aplicação -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">#485460</item>
        <item name="android:statusBarColor">#485460</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 2. Tema Principal da Aplicação sem Barra de Título -->
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        
        <!-- Define a cor da barra de estado nativa -->
        <item name="colorPrimaryDark">#485460</item>
        <item name="android:statusBarColor">#485460</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 3. Tema do Ecrã de Entrada (Splash Screen / Arranque) -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Imagem de fundo do ecrã de entrada -->
        <item name="android:background">@drawable/splash</item>
        
        <!-- Força a barra de estado a ser #485460 desde o primeiro segundo -->
        <item name="android:statusBarColor">#485460</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Transição suave para o tema principal assim que a app carrega -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

</resources>